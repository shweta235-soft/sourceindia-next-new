NEXT_PUBLIC_API_BASE_URL=https://react.sourceindia-electronics.com/v4/api
# Set to the public asset host root (without /api) when site settings return relative paths
NEXT_PUBLIC_ASSET_BASE_URL=https://react.sourceindia-electronics.com/v4

# Generate your own random secret for the server-side admin session. Keep this in .env.local.
ADMIN_SESSION_SECRET=

# Required only for /api/local/* database-backed APIs (server-side secrets).
# Set these in .env.local and keep them private; do not commit credentials.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Required for local authentication. Use your own random 32+ character secret.
LOCAL_AUTH_JWT_SECRET=

# Bulk106 signed Admin status updates (DANGEROUS on real data): keep false for read-only testing.
LOCAL_ADMIN_BULK106_WRITES_ENABLED=false

# Bulk107 management write operations are OFF by default. Do not enable on production or shared data.
LOCAL_ADMIN_BULK107_WRITES_ENABLED=false

# Isolated disposable DB ONLY. Do not enable against production data.
LOCAL_ADMIN_BULK108_WRITES_ENABLED=false

# BULK117 original Express controller compatibility (temporary, not native migration).
# In development, GET endpoints use the original controllers by default.
# Production bridge stays disabled by default; do NOT enable without security QA.
SOURCEINDIA_LEGACY_COMPAT_PRODUCTION=0
# Only enable writes against an isolated disposable database with emails/uploads mocked.
SOURCEINDIA_LEGACY_COMPAT_WRITES=0
# GET paths known to mutate DB/send email/track are additionally disabled.
SOURCEINDIA_LEGACY_COMPAT_SIDE_EFFECTFUL_GET=0

# BULK122 — Native ticket WRITE endpoints are DISABLED by default, and ALWAYS
# blocked with NODE_ENV=production. Never point them at a real/live DB.
# To opt in on an isolated LOCAL CLONED QA database only:
# SOURCEINDIA_TICKET_NATIVE_WRITES_ENABLED=1
# SOURCEINDIA_TICKET_QA_DB_NAME=sourceindia_qa_test   # must equal DB_NAME
# DB_HOST=127.0.0.1                                  # loopback only
# DB_NAME=sourceindia_qa_test                         # must contain qa/test/sandbox
# OTP email requires ALL of the following (allowlisted QA inboxes ONLY):
# SOURCEINDIA_TICKET_QA_SMTP_HOST=localhost
# SOURCEINDIA_TICKET_QA_SMTP_PORT=1025
# SOURCEINDIA_TICKET_QA_SMTP_USER=qa_user
# SOURCEINDIA_TICKET_QA_SMTP_PASSWORD=qa_password
# SOURCEINDIA_TICKET_QA_MAIL_FROM=qa-support@example.test
# SOURCEINDIA_TICKET_QA_MAIL_ALLOWLIST=qa-receiver@example.test
# BULK123 user+admin ticket notifications, DISABLED by default. Only QA allowlisted inboxes:
# SOURCEINDIA_TICKET_QA_NOTIFICATIONS_ENABLED=1
# SOURCEINDIA_TICKET_QA_ADMIN_EMAIL=admin-qa@example.test
# Add admin-qa@example.test to SOURCEINDIA_TICKET_QA_MAIL_ALLOWLIST.
# Private QA-only files are written under .qa-private-ticket-files/ (never public).
# File downloads require a valid admin session or Bearer ticket tracker token.

# BULK126 Completion — Applications native image writes (DISABLED by default).
# NEVER enable against production or your existing working database.
# On a disposable LOCAL QA database, copy this sample to your private .env.local:
# SOURCEINDIA_APPLICATION_WRITES_ENABLED=1
# SOURCEINDIA_APPLICATION_QA_DB_NAME=sourceindia_applications_qa_test  # same as DB_NAME
# SOURCEINDIA_APPLICATION_QA_TOKEN=<your own random secret, 32+ characters>
# SOURCEINDIA_APPLICATION_QA_STORAGE_ROOT=E:\\sourceindia-applications-qa-storage
# DB_HOST=127.0.0.1
# DB_NAME=sourceindia_applications_qa_test
# QA image files will be under: <QA_STORAGE_ROOT>/upload/applications/
# These APIs always deny writes when NODE_ENV=production.

# BULK127 Contacts — isolated QA only, production writes forbidden
SOURCEINDIA_CONTACT_WRITES_ENABLED=0
SOURCEINDIA_CONTACT_QA_DB_NAME=
SOURCEINDIA_CONTACT_QA_TOKEN=
SOURCEINDIA_CONTACT_QA_EMAIL_ENABLED=0
SOURCEINDIA_CONTACT_QA_SMTP_HOST=
SOURCEINDIA_CONTACT_QA_SMTP_PORT=587
SOURCEINDIA_CONTACT_QA_SMTP_USER=
SOURCEINDIA_CONTACT_QA_SMTP_PASSWORD=
SOURCEINDIA_CONTACT_QA_MAIL_FROM=
SOURCEINDIA_CONTACT_QA_ADMIN_EMAIL=
SOURCEINDIA_CONTACT_QA_MAIL_ALLOWLIST=
